// Работа с изображениями: интернет и локальный файл, альфа-смешивание.
window 900 400 "images"
background #1a1a2e

// Фото из интернета (сервис picsum.photos отдаёт случайное фото).
image 20 20 420 280 "https://picsum.photos/seed/renderex/420/280"

// Полупрозрачная подложка под вторую картинку.
rect 480 20 380 260 #ffffff44

// Локальный файл: путь считается относительно папки сценария.
image 500 40 340 220 "assets/sample.png"
circle 850 300 60 orange
