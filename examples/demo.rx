// Демо-сцена renderex: фигуры, линия, изображение из интернета.
// Команды разделяются переносом строки или ';'.

window 800 600 "Renderex — привет из Казани!"   // разрешение и заголовок окна
background #101020                              // тёмный фон

circle 150 300 90 #3498db       // синий круг (x, y, радиус, цвет)
square 300 200 130 tomato       // квадрат именованным цветом
rect 480 380 260 160 #2ecc71    // зелёный прямоугольник
triangle 150 120 260 90 210 220 gold
ellipse 550 150 120 70 #9b59b6
line 90 60 700 60 white 3

// Картинка из интернета: x, y, ширина, высота, URL
image 480 90 220 140 "https://picsum.photos/id/1080/400/250"
